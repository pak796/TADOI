{
  "name": "tadoi",
  "description": "TADOI - Terminal Accessible Digital Organization Interface",
  "version": "0.3.7",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "package.json"
  ],
  "bin": {
    "tadoi": "bin/tadoi.js"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "postinstall": "bun run completions:install:user",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "brand:check": "bun scripts/check-legacy-branding.ts",
    "contract:dtf:check": "bun scripts/check-dtf-contract-drift.ts",
    "pack:dry": "mkdir -p dist/tarball && bun pm pack --destination dist/tarball --quiet",
    "pack:inspect": "bun scripts/inspect-package.ts",
    "pack:smoke": "bun scripts/package-smoke-test.ts",
    "release:rc:check": "bun run test && bun run typecheck && bun run brand:check && bun run contract:dtf:check && bun run pack:dry && bun run pack:inspect && bun run pack:smoke",
    "build:bin:mac": "bun scripts/build-binary.ts --target macos --format raw",
    "build:bin:win": "bun scripts/build-binary.ts --target windows --format raw",
    "build:bin:linux": "bun scripts/build-binary.ts --target linux --format raw",
    "build:installer:mac:raw": "bun scripts/build-binary.ts --target macos --format raw --mode build",
    "build:installer:mac": "bun scripts/build-binary.ts --target macos --format installer --mode build",
    "build:installer:mac:all": "bun run build:installer:mac:raw && bun run build:installer:mac",
    "release:mac:test": "bun run test && bun run typecheck && bun run build:installer:mac:all",
    "notion:mcp:setup": "bash scripts/notion-mcp-setup.sh",
    "notion:mcp:login": "bash scripts/notion-mcp-setup.sh --login",
    "notion:mcp:repair": "bash scripts/notion-mcp-setup.sh --reset --login",
    "completions:install:user": "bun scripts/install-completions.ts --layout user",
    "dev": "bun src/index.tsx",
    "start": "bun src/index.tsx",
    "installer:smoke": "bun scripts/installer-smoke-test.ts",
    "installer:gate": "bun scripts/installer-artifact-gate.ts",
    "build:daily": "bun scripts/build-daily.ts",
    "keybind:audit": "python3 scripts/keybind-sync-audit.py",
    "notion:sync:validate": "bun scripts/notion-sync-full.ts --validate-only",
    "notion:sync:full": "bun scripts/notion-sync-full.ts",
    "notion:sync:full:dry": "bun scripts/notion-sync-full.ts --dry-run"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.1.79",
    "@opentui/react": "0.1.79",
    "bun": "^1.3.9",
    "dev": "^0.1.3",
    "react": "^19.0.0",
    "rrule": "^2.8.1",
    "run": "^1.5.0"
  },
  "overrides": {
    "diff": "8.0.3"
  }
}
